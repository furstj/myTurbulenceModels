FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0.84 0 0 );

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField; 
    }
    outlet
    {
        type            zeroGradient;
    }
    plate
    {
        type            noSlip;
    }
    upperWall
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
}


